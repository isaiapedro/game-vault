# Local-only configuration. Copy to config/.env and fill values privately.
# Runtime ports follow the root configuration matrix and Registry reservation.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/game_vault

# Optional IGDB metadata and cover lookup.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional existing PSN client connection. Never share or commit a real token.
PSN_NPSSO=

# Optional release-preparation-only Mercado Livre candidate search.
# Supply privately in the shell when invoking scripts.discover_mercado_livre.
# MERCADO_LIVRE_ACCESS_TOKEN=

# Comma-separated exact browser origins. Both local hostnames work by default.
# ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
